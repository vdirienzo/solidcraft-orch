# PLANTILLA de la configuracion del LOOP. El fichero real es `config.env` en
# $LOOP_DIR y NO esta en git (el .gitignore del repo cubre `.env` y `*.env`).
#
# POR QUE UNA PLANTILLA Y NO EL REAL: el real lleva las rutas de UNA maquina
# (/home/user/...), y el repo tiene que poder instalarse en otra PC. Este fichero
# es la forma parametrizada: cada ruta es una variable con default, asi que
# `cp config.env.example config.env` funciona en cualquier maquina y se puede
# sobreescribir con el entorno.
#
# Este fichero se SOURCEA como bash. Los valores con ESPACIOS van SIEMPRE entre
# comillas: sin comillas, bash lee `VAR=valor con espacios` como la asignacion
# VAR=valor seguida del comando `con espacios`, que no existe; el sourceo se
# rompe en silencio a mitad del fichero y el script sigue con la mitad de la
# politica. bin/config-check.sh lo verifica.
#
# NO hay secretos aqui: la configuracion de esta maquina solo tiene rutas y
# politica. Si alguna vez un valor real fuera una credencial, la credencial
# NUNCA se versiona: va en el config.env local, que queda fuera de git.
REPO="/home/user/solidcraft"
GATE_WORKTREE="/home/user/solidcraft-gate"
# Worktree dedicado a las capturas de evidencia: el checkout principal tiene el
# overlay local de AGENTS.md sin commitear y un `git checkout` de una rama
# falla ahí.
EVIDENCE_WORKTREE="/home/user/solidcraft-evidence"
FORK=https://github.com/vdirienzo/solidcraft.git
# CARGO_TARGET_DIR: el target dir que usa cargo. El valor por defecto es el
# checkout principal (lo que usa el servicio del loop), pero un valor ya
# exportado por el que llama GANA: asi el orquestador puede darle a cada
# agente su propio target dir (targets/slot-<issue>) y dos agentes no se
# pelean por el lock de compilacion de un solo directorio.
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-/home/user/solidcraft/target}"
GATE_TARGET_DIR="/home/user/solidcraft-gate/target"

# Chrome headless: sin esto el web-offline-test de `cargo xtask ci` se saltea
# en silencio (find_chrome() sólo mira $CHROME y google-chrome/chromium en el PATH).
CHROME="/home/user/.local/chrome/chrome-linux64/chrome"
CHROME_LD="/home/user/.local/chrome-deps/usr/lib/x86_64-linux-gnu:/home/user/.local/chrome-deps/lib/x86_64-linux-gnu"

# Stack gráfico headless: Xvfb + lavapipe (Vulkan por software).
X_ROOT="/home/user/.local/x"
X_LD="/home/user/.local/x/usr/lib/x86_64-linux-gnu"
XKB_CONFIG_ROOT="/home/user/.local/x/usr/share/X11/xkb"
VK_ICD_FILENAMES="/home/user/.local/x/usr/share/vulkan/icd.d/lvp_icd.json"
DISPLAY=:99
SOLIDCRAFT_GPU=cpu
SOLIDCRAFT_RENDERER=cpu

MIN_FREE_GB=60
SKIP_FREE_GB=25
DISK_DEPS_MAX_GB=60            # tope de `deps` del gate y del checkout principal: sin tope
                              # el gate reconstruye 106 GB de deps en 3,5 días. 0 = sin tope
DISK_DEPS_GRACE_S=600          # un artifact más joven que esto no se borra nunca: puede
                              # estar en uso; el tope espera a que el trabajo termine

# --- Cuotas y modos (Prompt 2) ---
# Techo real: ~10 PRs/día (53 vueltas/día ÷ ~5,5 vueltas por issue); 12 = margen con red de seguridad finita.
MAX_PR_PER_DAY=24             # máximo de PRs publicados por día (techo real ~10-12/día)
MAINT_THRESHOLD=10            # umbral para entrar en modo maintenance: el objetivo es
                              # arreglar issues, no que el maintainer mergee. El
                              # maintainer pide "unos 10 PRs abiertos como mucho"
                              # (27-10-2026): con 40 el loop publicaba diez PRs más
                              # de los que el maintainer puede revisar. Este valor es
                              # el autoparqueo del loop; el tope REAL lo aplica
                              # bin/claim-guard.sh antes de abrir cada PR.
# El funnel del reclamo (27-10-2026): los filtros viven en CODIGO, no en el
# prompt. Un modelo que lee "no reclames un issue ya reclamado" en el prompt
# lo olvida una vez de cada tanto; un script no.
# Las labels que sacan un issue del funnel. La lista es separada por comas y
# una label puede tener espacios ("in progress"), por eso no son espacios.
# `status:decision` (27-10-2026): el maintainer ya decidió sobre el issue y
# eso NO es un bug que arreglar: el loop se callaba y lo devolvia al pool.
CLAIM_EXCLUDED_LABELS="in progress,kernel-paused,status:decision,needs-info,area:kernel"
CLAIM_WANTED_LABEL=bug         # la label que el funnel quiere
CLAIM_CANDIDATE_LIMIT=20       # cuantos candidatos imprime la lista
CLAIM_SCAN_LIMIT=25            # cuantos issues del funnel se consultan en su
                              # timeline (una llamada a la API por issue: el
                              # escaneo está acotado para que la lista no tarde
                              # minutos)
CLAIM_PR_LIMIT=2000            # cuantos PRs abiertos se consultan por las menciones:
                              # el upstream tenía 637 abiertos (27-10-2026) y un
                              # tope de 100 truncaba la lista: el guard no veía el
                              # reclamo de un PR de otro autor.
                              # El tope subio a 1000 el 31-10-2026: con 700 el
                              # upstream tenia 749 PRs abiertos y el guard
                              # devolvia "does not know" (ciego) para CADA
                              # chequeo de duplicados.
                              # MEDIDO el 9-11-2026: el upstream tiene 1009
                              # PRs abiertos y el guard se quedaba ciego
                              # ("unknown-truncated") para TODOS los issues: no
                              # publicaba nada. La premisa de que "1000 es el
                              # techo de gh pr list" era FALSA: con
                              # --limit 2000 la API devuelve los 1009 PRs, todos
                              # con su body (0 vacios). `gh pr list` pagina bien
                              # por encima de 1000; el tope era un numero
                              # nuestro, no un limite de la herramienta. Por eso
                              # el tope subio a 2000: con holgura sobre las 1009
                              # actuales, y vuelve a crecer cuando el upstream
                              # pase las 2000 (el guard avisa "truncated" y la
                              # estrategia a cambiar sera el listado por REST
                              # paginado, no un tope mas alto).
MIN_MINUTES_BETWEEN_PUBLISH=0  # publicar en cuanto el PR queda gated + aprobado (0 = sin separación)
MAX_WORK_MINUTES_PER_ISSUE=60 # time-box del IMPLEMENT por issue (no es el del turno): con 45 el loop abandonaba fixes a medio hacer
MAX_LOAD=24                   # carga máxima para seguir con una vuelta
GATE_TIMEOUT_MIN=300          # watchdog: the HARD CEILING of the complete gate. Past this
                              # age its process group gets TERM and then KILL, and the
                              # phase is marked `failed`. It is only the BACKSTOP: the
                              # verdict of the watchdog is decided by the PROGRESS (the
                              # log moving) and by the DRIFT (the sha it gates is no
                              # longer in the branch), never by the age alone. The age
                              # alone killed two gates that were making progress: one
                              # run measured 169 min (10,119 s) and the 180 min ceiling
                              # killed it with 8,742/8,850 tests already green.
                              # It costs no CPU and no RAM: the watchdog is a hang
                              # detector, not a scheduler.
GATE_SILENT_MIN=90            # watchdog: a gate whose log has not moved for this many
                              # minutes is STUCK, even if it is younger than the ceiling.
                              # The complete gate prints its slow tests every 60 s, so a
                              # gate that works refreshes the log every minute; a gate
                              # that says nothing for an hour and a half holds ten cores
                              # and thirty gigabytes and is not going to say more.
                              # 90 min is 1.5x the observed 60 s heartbeat: it cannot
                              # fire on a gate that works, even on a slow disk.

# El gate de scope (bin/gate-quick.sh): corre los tests (nextest) de los
# paquetes que el cambio toca, más cargo fmt --check, cargo xtask layers, un
# clippy del alcance y (GATE_CHECK_WORKSPACE=1) un cargo check del workspace.
# Tarda MINUTOS y su veredicto (VERDE-SCOPE) SÍ publica: el gate completo es
# opcional, no la única vía. El gate COMPLETO (89-116 min) no se espera dentro
# de un turno: se lanza y se sale.
#
# EL PRESUPUESTO: el gate usa el tiempo que le queda al TURNO, nunca más:
# el supervisor le pasa GATE_QUICK_TIMEOUT_MIN = (minutos que le quedan al
# turno - 2), acotado entre GATE_QUICK_MIN_MIN y GATE_QUICK_TIMEOUT_MIN. Un
# gate al que systemd mata cuando acaba su turno NO deja veredicto, y un
# turno sin veredicto es un turno perdido.
GATE_QUICK_TIMEOUT_MIN=60     # techo del gate de scope (todo el run, repartido en las fases: con el check del workspace fmt 2%, layers 2%, clippy 8%, check 8%, nextest 80%; sin el check fmt 2%, layers 2%, clippy 10%, nextest 86%). MEDIDO (01-11-2026): con 30 min el gate del slot 7114 tardo 33m43s y salio DEFERRED=nextest-timeout (aplazado, no rojo), o sea el trabajo de una hora se tira. Con 60 el mismo gate entra holgado. Con 2 gates a la vez cada uno usa la mitad de los threads: el tiempo sube, pero los dos terminan.
GATE_QUICK_MIN_MIN=12         # suelo: con menos de 12 min no se lanza (no hay tiempo para el nextest) y el turno siguiente lo lanza con el presupuesto entero

# LOS SLICES DE LAS FASES (medidos, 27-10-2026, caja de 16 vCPU, target dir
# frío): el gate reparte el presupuesto entre sus fases con porcentajes, y
# la suma es EXACTAMENTE el presupuesto (la cuota de los tests es lo que QUEDA
# de los otros slices). Cada fase recibe su slice; si se pasa, se marca como
# saltada y el run sigue.
#
#   MEDIDO: fmt 2%  layers 2%  clippy 8%  check 8%  nextest 80%
#   MEDIDO: fmt 2%  layers 2%  clippy 10% nextest 86%      (sin el check)
#
#   tiempos reales: fmt 1 s · layers 3 s · clippy del alcance 2m10s (130 s) ·
#   check --workspace --all-targets 1m53s (113 s) · nextest del alcance
#   21m41s (1301 s: 677 s para enlazar los binarios de los tests y 624 s para
#   correrlos)
#
# LA GUARDA DEL CHECK: el check del workspace NO es gratis (1m53s) y el
# cálculo del alcance (cargo metadata + affected.py) también come del
# presupuesto (1-5 min). Así que el check sólo corre si el tiempo que queda
# paga el check Y los tests del alcance (CHECK_LEFT >= CHECK_SLICE +
# NEXTEST_SLICE, que con el reparto actual es el 88% del presupuesto): si no
# cabe, se salta SIN ejecutarlo y el alcance conserva sus tests. Un check que
# se come el tiempo de los tests deja el alcance sin tests, y un alcance sin
# tests es rojo: el gate no publicaría nunca.
#
# La fase del check es SOFT: un timeout suyo es check:skipped (tolerado) y el
# run sigue; un fallo de compilación es check:fail y sigue siendo rojo.
#
# La fase del clippy también es SOFT: es la fase que CRECE con el alcance, así
# que su corte es check-style "no alcanzamos a saber", nunca un rojo. Sus
# FALLOS (su exit code) siguen siendo rojos: eso sí es un error de código.

# --- El pool de tests del gate completo ------------------------------------
# `cargo xtask ci` lanza los 80 binarios de test A LA VEZ (sin límite): 81
# procesos concurrentes sobre 16 vCPU, cada uno con sus propios hilos. Con la
# máquina así de saturada los tests de aserciones de TIEMPO fallan por la
# carga, no por el código (el ui-egui: 448 ms de frame contra un presupuesto
# de 250 ms), y un gate ROJO por eso cuesta un gate entero.
#
# MEDIDO (25-10, commit 08c63286, target dir caliente, 80 binarios):
#
#   sin tope   3817 s (el gate histórico más rápido) ... 3974 s (el más lento)
#   4x4       4966 s   load máx 87,5   139 procesos a la vez
#   8x2       7660 s   load máx 105    159 procesos a la vez
#
# O sea: el pool acotado es UN 37 % MÁS LENTO en reloj (contra la mediana
# histórica de 3636 s) y usa un tercio de la máquina. A cambio, en las
# corridas acotadas NINGUNA aserción de tiempo falló (en la corrida sin tope
# fallaron tres: geom 647 ms contra 200, io 59,5 s contra 30, engine 95,5 s
# contra 30). Ese es el trato: se paga reloj para que el gate dé VERDE y no
# ROJO por la saturación de la máquina.
#
# 4x4 es el punto óptimo: con 8x2 el binario largo (`engine lib`, 2257 tests)
# tarda mucho más (2 hilos por binario), y con más jobs no caben más hilos
# por core.
#
# `SOLIDCRAFT_TEST_JOBS` ya está en el upstream que está instalado
# (xtask/src/test.rs) y RUST_TEST_THREADS es la variable estándar de libtest
# (la heredan los binarios): no hace falta el merge de nuestro PR #5808.
GATE_TEST_JOBS=3
GATE_TEST_THREADS=2

# --- Los limites del gate (26-10-2026) -------------------------------------
# El OOM killer mato el gate TRES veces el 26-10-2026 (pico de 47,4 GB sin
# limite, luego 32 GB y luego 28 GB), y el host no tiene swap. Los limites:
#   - la compilacion acotada (4 jobs): cargo compila con un job por nucleo y
#     el crate `engine` es grande; un solo rustc llega a 9 GB de RSS.
#   - el rasterizador de lavapipe acotado (4 hilos): por defecto es uno por
#     nucleo, cada uno con su scratch.
#   - el regulador y el cinturon DE LA UNIDAD: la unidad del gate tiene cgroup
#     propio, asi que si se pasa muere el gate y no el loop. NO van en la slice
#     del usuario: alla la page cache de toda la maquina esta cargada y el
#     limite mataria otra cosa (ver el RUNBOOK, seccion L4').
#     MemoryHigh (32G) es el que importa: por encima de el el kernel reclaima
#     la page cache del gate de forma agresiva, asi que los ~10 GB de cache
#     del build y los ~15 GB de memoria anon de los tests pesados de geometria
#     no se suman en el peor momento. MemoryMax (40G) es el cinturon.
#     MEDIDO (27-10-2026): con MemoryHigh=20G el gate se estrangulaba a si
#     mismo. El anon llego a 21,9 GB (> MemoryHigh) y la maquina NO tiene
#     swap, asi que el reclaim era imposible: el throttling era perpetuo
#     (`memory.events high` 3.116.552 -> 4.921.589 en ~40 min, `oom 0`) con la
#     CPU ociosa al 92-98 % y el run mas largo en >42 min (el upstream tarda
#     ~20 min en 32 vCPU). Con 32G el pico de 21,9 GB cabe de sobra y
#     MemoryMax (40G) sigue siendo el cinturon. Afecta al SIGUIENTE gate: el
#     gate vivo no se toca.
GATE_BUILD_JOBS=4
GATE_LP_THREADS=4
GATE_MEMORY_HIGH=32G
GATE_MEMORY_MAX=40G

# --- The belt of the scoped gate (27-10-2026) ------------------------------
# The scoped gate (bin/gate-quick.sh) runs in the foreground of the supervisor,
# inside solidcraft-loop@0.service, whose memory.high and memory.max are both
# `max`: it had no belt at all, and it ran 19 times on 27-10-2026. The complete
# gate already has one (its own unit) and peaked at 25,127 MB with 12 nextest
# threads and 0 throttle events, so the scoped gate gets the same numbers: the
# measured peak fits with margin, and the scope cannot take the host down with
# it (62,8 GB of RAM and no swap).
GATE_QUICK_TARGET_DIR=/home/user/solidcraft-gate-quick/target
                              # the scoped gate's `ci` artifacts are 61 GB today: they
                              # must not land in /home/user/solidcraft/target, the dir
                              # the interactive sessions use and contend for the same
                              # cargo lock on
GATE_QUICK_MEMORY_HIGH=26G    # MEDIDO (01-11-2026): el pico real de un gate es 23.7 GB. Con DOS gates a la vez tienen que caber en los 62 GB de la caja: 2 x 26G de high y 2 x 23.7G de pico real dejan 14.6 GB de margen. Con el 32G de antes el segundo gate pediria 64 GB de demanda sobre 62 de RAM y el OOM killer se llevaria un binario de test, lo que se lee como un gate ROJO.
                              # leaves margin, and above it the kernel reclaims this
                              # scope's page cache instead of the host's
GATE_QUICK_MEMORY_MAX=32G     # el cinturon: pasado este punto el OOM killer se lleva el scope, no la maquina. Con el 40G de antes, dos scopes a la vez pedian 80G de techo sobre 62G de RAM.
                              # the supervisor that watches it
GATE_QUICK_CPU_WEIGHT=100     # parity with the loop's own service: the weight is a
                              # SHARE under contention, not a limit. With 50 the
                              # scope got half of the share of the loop's slice and
                              # the scoped gate missed its 30 min budget (EXIT=124,
                              # 720 of 3112 tests never ran)
GATE_QUICK_IO_WEIGHT=50       # half weight on the disk too: 61 GB of artifacts must
                              # not starve the builds of the interactive sessions.
                              # INERT on this host: the io controller is not delegated
                              # to the user manager (there is no io.weight file in the
                              # tree), so the manager accepts the property and the
                              # kernel never applies it. It is kept because it works
                              # on a host that delegates the controller
GATE_QUICK_SLICE='app-solidcraft\x2dloop.slice'
                              # the scope lives in the LOOP'S OWN slice, the one that
                              # holds solidcraft-loop@0.service, and NOT in app.slice:
                              # a scope with a CPU weight in app.slice turns the cpu
                              # controller on for that subtree and the complete gate
                              # (the critical path of the loop) becomes a third peer
                              # of it, losing a third of the CPU it has today.
                              # Measured: with the scope in app.slice, app.slice splits
                              # its CPU between three units (the complete gate 100, the
                              # loop slice 100 and the scope 50); inside the loop's
                              # slice the complete gate keeps the share it has today.
                              # The name is the ESCAPED one (the dash of
                              # "solidcraft-loop" is \x2d in the unit name of the
                              # slice); an empty value leaves the scope in the
                              # default place of the user manager
GATE_QUICK_TASKS_MAX=4096     # nextest is one process per test: 4096 fits the 12-thread
                              # pool with room and caps a runaway fork in the scope
GATE_QUICK_OOM_POLICY=kill    # on OOM kill the scope, not the slice: the gate dies and
                              # the supervisor lives
GATE_QUICK_CGROUP=1           # 1 = the scoped gate gets its own transient scope with
                              # these limits; 0 = no belt (the supervisor's own cgroup)
GATE_QUICK_RUNTIME_GRACE=120  # seconds the scope may live after the gate exits, so
                              # cargo is not cut off in the middle of a write

# --- El bucle se auto-sabotaba: restos, escombro y lock (27-10-2026) -------
# El 27-10-2026 dos gates de alcance corrieron A LA VEZ sobre el mismo
# target dir (/home/user/solidcraft-gate-quick/target): el perdedor no
# espera el lock de cargo, muere con "Blocking waiting for file lock on build
# directory" y se lleva por delante el gate entero. Y el muerto dejaba
# Binarios de nextest vivos en su cgroup, que se comian la RAM del host.
#
# (A) Los restos del cgroup: al final de cada fase y en el trap se matan
#     los procesos que siguen dentro del scope (el gate NO puede matar por
#     grupo de procesos: los binarios de test de nextest tienen su propio
#     PGID). Se excluyen el propio gate, sus ancestros, los zombies y el
#     daemon de sccache.
# (B) El escombro: al arrancar, los scopes muertos (sin gate vivo dentro y
#     mas viejos que el gracia) se matan y se paran. Un scope que se esta
#     Starting todavia NO es escombro.
# (C) El lock: los gates de alcance se serializan con flock sobre
#     gates/scope.lock. El que no lo saca NO compila: se APLAZA
#     (DEFERRED=scope-gate-alive), y no pisa un veredicto fresco del mismo sha.
#     Todo esto es fail-open: si no hay cgroup, systemd o flock, el gate
#     sigue como antes.
GATE_SCOPE_LOCK_WAIT=0          # segundos que un gate de alcance espera el lock
                                # del target dir antes de aplazarse. 0 = no espera:
                                # se aplaza al instante (el defecto). El lock se
                                # toma en la copia INTERNA del gate, despues de
                                # calcular el alcance, para no bloquear mientras
                                # se calcula
GATE_SCOPE_CLEAN_GRACE=120      # segundos que un scope tiene que ser viejo
                                # para que se trate como escombro. Un scope que
                                # se acaba de crear puede estar en medio de su
                                # propio arranque: matarlo mataria una vuelta que
                                # todavia no empezo
GATE_CGROUP_ROOT=/sys/fs/cgroup  # la raiz de la jerarquia de cgroups. En una
                                # maquina normal es /sys/fs/cgroup; en los tests
                                # es un directorio del test (un test que no puede
                                # armar un arbol de cgroups solo puede leer el
                                # codigo del gate, y el codigo no es el
                                # comportamiento)

# --- El timeout de los tests y el alcance de los tests (27-10-2026) -------
# (a) EL TIMEOUT DE LOS TESTS ES UN APLAZAMIENTO, NO UN ROJO.
#     Cuando el timeout del gate mata al runner, los tests que estaban
#     corriendo mueren con el: el log dice "SIGTERM" y el resumen cuenta un
#     fallo que NUNCA ocurrio. Un parser que no sabia del corte leia un FAIL
#     inventado (27-10-2026: el gate dio ROJO-SCOPE con DOS fallos
#     inventados y la lista de fallos VACIA: el agente no tenia nada que
#     arreglar y el slot quedaba bloqueado).
#     Ahora un corte SIN fallos reales es un APLAZAMIENTO:
#         GATE_STATUS=skipped
#         VERDICT=SKIP
#         DEFERRED=nextest-timeout
#         NEW_FAILURES=0
#         FAILED_TESTS=        (vacio)
#     Un fallo REAL hallado antes del corte SIGUE SIENDO ROJO (el corte no lo
#     tapa) y un test que muere por si solo (SIGTERM con un run que NO fue
#     cortado) SI es un fallo. El corte se decide en UN solo sitio, al final
#     del gate, cuando ya se conocen todos los problemas: un aplazamiento
#     NUNCA tapa un rojo real.
#
# (c) LOS TESTS VAN SOLO AL CRATE TOCADO.
#     El alcance de la COMPILACION (el clippy y el check del workspace) se
#     mantiene entero: un dependiente que no compila sigue siendo rojo. El
#     alcance de los TESTS se acota a los paquetes cuyo DIRECTORIO contiene
#     un fichero cambiado (bin/touched-packages.py): los dependientes NO
#     entran, porque un test de un dependiente no es un test del cambio.
#     Si el alcance no se puede calcular (un fichero que no es de ningun
#     paquete, un metadata que falla, el script que no existe), los tests
#     corren sobre el alcance ENTERO: un run mas estrecho es una
#     optimizacion, un run mas estrecho equivocado es un verde que tapa un
#     rojo. El script se puede cambiar (o dejar sin existir) para apagar el
#     acotado sin tocar el codigo.
TOUCHED_SCRIPT="/home/user/.local/share/solidcraft-loop/bin/touched-packages.py"

# --- La politica del gate completo (27-10-2026) ---------------------------
# El maintainer, sobre correr `cargo xtask ci` ANTES de publicar (27-10-2026):
# el CI del upstream ya corre la suite COMPLETA cuando un maintainer revisa el
# PR y pone `approved-for-ci`, y la cola de merge la corre otra vez sobre main.
# Correrla localmente antes de publicar cuesta ~90-180 min de CPU y ~35 GB de
# RAM (el OOM killer se llevo un gate entero el 27-10) y NO evita ni un solo
# check rojo: lo que cuesta es un check rojo, no un main roto.
#
# El gate local justo (bin/gate-quick.sh: fmt + check del workspace + clippy
# del alcance + nextest del alcance) tarda minutos con el target dir caliente,
# y su veredicto (VERDE-SCOPE) SI publica.
#
# GATE_COMPLETE_MODE:
#   off    = no se lanza el gate completo. Es el defecto (27-10-2026).
#   manual = solo si un humano lo pide (SOLIDCRAFT_GATE_FORCE=1).
#   auto   = el loop lo lanza como antes (opt-in explicito).
GATE_COMPLETE_MODE=off
# El gate de alcance anade `cargo check --workspace --all-targets --profile ci`:
# atrapa una rotura de compilacion en CUALQUIER crate, no solo en el alcance.
GATE_CHECK_WORKSPACE=1
# RUSTC_WRAPPER=sccache: el CI del upstream compila con sccache
# (.github/workflows/ci.yml) y el bucle no (0 peticiones hasta el 27-10): cada
# run recompilaba todo desde cero. Con red de seguridad: un paso que falla con
# sccache se reintenta UNA vez sin el wrapper (un fallo de cache no es un
# fallo de codigo: el ledger registra un gate entero perdido por una caida de
# sccache al compilar los binarios de test).
GATE_SCCACHE=1

# --- El runner de los tests del gate (26-10-2026) ---------------------------
# `nextest` y no `cargo test`: un proceso POR TEST, como el CI del upstream.
# Con `cargo test` todos los tests de un binario corrien en UN proceso y la
# memoria que acumulan no se devuelve: el binario de los tests de GPU llego a
# 21,7 GB de anon (140 tests, ~155 MB cada uno) y eso es lo que mataba el
# gate con el OOM killer (un solo test de ese binario usa 217 MB).
# Ademas el CI de la cola de merge del upstream corre nextest, asi que el gate
# local es un proxy mas fiel de ese CI, y desaparecen los falsos rojos de
# orden de dibujo (un test solo en su proceso dibuja en un orden estable).
GATE_TEST_RUNNER=nextest
# MEDIDO (26-10-2026) con los tiempos del propio upstream (el junit.xml de su
# run de la cola de merge, 8231 tests): el alcance de 13 paquetes (un cambio en
# crates/geom, que manda sobre casi todo) son 6.737 s de tiempo de test tras el
# filtro de un pull request. Con 6 hilos son 1.123 s (18,7 min): NO cabe en la
# rebanada del nextest. Con 12 hilos son 561 s (9,4 min) y caben. La maquina
# tiene 16 nucleos y 62,8 GB de RAM (medido en el RUNBOOK, seccion L4'); el
# cgroup de la UNIDAD del gate se queda con 32 GB de `MemoryHigh` y 40 GB de
# `MemoryMax`. El runner del upstream tiene 16 vCPU y corre los mismos tests
# con 16 hilos.
GATE_NEXTEST_THREADS=12    # tests a la vez (el CI del upstream deja uno por nucleo; aqui la memoria manda: 12 y no 16)

# El alcance de los TESTS puede incluir los paquetes DEPENDIENTES del que se
# toca (los que dependen de él): `NEXTEST_INCLUDE_DEPENDENTS=1` lo enciende y
# cualquier otro valor lo deja apagado (un knob roto nunca ensancha nada).
# Con `1` el alcance lo calcula el script del upstream
# (`scripts/ci/affected.py`); si ese script falla, el gate NO se pone rojo por
# eso (falla ABIERTO: los tests se quedan en el alcance estrecho, el de los
# owners) y avisa por stderr. Solo cambia el alcance de los TESTS: el de la
# compilación (clippy + check del workspace) no se ensancha.
#
# POR QUE ESTA ENCENDIDO (31-10-2026): el maintainer pide el nextest "on the
# crates scripts/ci/affected.py selects", y affected.py mete a los
# DEPENDIENTES del paquete tocado. Con el alcance estrecho (solo los owners)
# el gate del slot 10138 corrio 4174 tests y se dejo afuera a `solidcraft` y
# `solidcraft-web`, que son justo los que affected.py pide. MEDIDO: el
# alcance ancho corrio 4320 tests (146 mas) en 462 s contra 496 s del
# estrecho: NO cuesta mas tiempo, porque los binarios ya estan compilados en
# el target dir del slot y los tests de los dos paquetes son una fraccion.
# El costo de ensanchar es de COMPILACION (target dir frio), no de tests.
#
# OJO: el valor que GOBIERNA el gate scoped esta en bin/gate-quick.sh, que
# NO sourcea este fichero (lee sus knobs del entorno de quien lo llama).
# Este valor es la copia del loop viejo: si se cambia aca, el gate scoped no
# se entera. Los dos tienen que decir lo mismo.
NEXTEST_INCLUDE_DEPENDENTS=1

# --- La limpieza del disco (bin/gc-disk.sh) ---------------------------------
# El disco se llenaba sin que nadie lo notara: los caches incremental de cargo
# (94 GB en el checkout principal), los worktrees de sesiones muertas y las
# ramas locales de PRs ya cerrados. El script borra eso una vez al día; el
# supervisor lo llama al principio de la vuelta.
DISK_GC_ENABLED=1             # 0 = no se limpia nunca
DISK_GC_INTERVAL_H=24         # una vez por día (la vuelta llama al script, el guardia lo hace diario)
DISK_GC_MIN_FREE_GB=120       # con menos espacio libre, el --deep puede correr solo
DISK_GC_ARTIFACT_DAYS=14      # edad de los artifacts que borra el modo --deep
DISK_GC_WT_MIN_AGE_H=12       # un worktree tocado hace menos de esto NO se toca
DISK_GC_KEEP_PREFIXES=main,feat/,docs/,spike/,agent/   # ramas que nunca se borran
# TTL de las ramas locales (días). Acota el "nunca se borran" de arriba: una
# rama `backup/*` o `archive/*` más vieja que esto deja de estar protegida.
# bin/gc-disk.sh SÍ lee esta clave (su sección 6): la rama se exporta a un
# bundle antes de borrarse, y el GC nunca borra un bundle. `backup/` NO está
# en DISK_GC_KEEP_PREFIXES a propósito: si lo estuviera, el TTL no aplicaría
# nunca y las ramas de respaldo se acumularían para siempre.
DISK_GC_BRANCH_TTL_DAYS=30
# Dónde se escribe el bundle de una rama vencida. Tiene que vivir bajo
# $LOOP_DIR/bin: el bundle es la única copia que sobrevive al borrado de la
# rama. La ruta absoluta evita depender del directorio de trabajo.
DISK_GC_BUNDLE_DIR="/home/user/.local/share/solidcraft-loop/bin/bundles"

# El contador de tokens NO se mide en cada latido. bin/metrics-snapshot.sh
# corre cada 5 minutos (el timer solidcraft-loop-metrics.timer), pero el
# contador (bin/oc-tokens) barre toda la base de datos de OpenCode: pedirle un
# número cada 5 minutos gasta CPU en una cifra que en 5 minutos no se mueve.
# Este knob son los MINUTOS que tienen que pasar entre dos lecturas.
#   60 = una lectura por hora (default).  0 = cada latido (el ritmo viejo).
# Entre dos lecturas se ARRASTRA el último valor (estado en
# $LOOP_DIR/tokens-sample.state), así que el informe diario
# (bin/compare-baseline.py) sigue encontrando tokens_24h y cost_24h.
# Un knob roto (o vacío, o con letras) es el default: nunca cambia el ritmo
# por sorpresa. OJO: la unit de systemd NO carga config.env, así que el
# default 60 del script es el que rige en producción; este knob sirve si se
# exporta en el entorno del service.
METRICS_TOKEN_SAMPLE_MIN=60

MAX_TURN_MIN=75              # un turno del loop no puede pasar de esto (mata el opencode run); con el gate rápido dentro del turno (1-5 min) el implement (60) + revisión + gate rápido caben en 75
TURN_TOKEN_BUDGET=40000000   # techo de tokens por turno (0 = sin techo). OJO: el delta de un turno se emite al FINAL (medido: al 100% de sus tokens), así que parar un turno a medias tira su trabajo y la issue se reimplementa. Por eso es una red de seguridad, no una optimización: 40M está por encima de todos los turnos medidos (el más caro hizo 51M con el techo de compactación viejo; con el techo de 150K baja a ~21M). Medido: 8M -> 12 de 200 turnos parados (-19% del coste del loop), 4M -> 31 (-34%)
MODEL=minimax/MiniMax-M3.1-Flash   # el modelo free por defecto NO corre con --session
CONTEXT_WINDOW=1000000   # la ventana de contexto del modelo. El techo de la compactación es esta ventana MENOS el buffer (compaction.buffer): con el buffer sin poner, OpenCode deja libre el 15% de la ventana (850.000), y con buffer=850.000 el techo es 150.000

# La escalera del experimento del techo del contexto. Cada día de la escalera
# es un día COMPLETO con un solo techo, para que los días se puedan comparar
# entre sí (bin/cache-effect.py) y contra la línea base (bin/compare-baseline.py).
# El último peldaño es un techo ya medido: el experimento nunca deja el loop en
# un estado que nadie haya validado.
CEILING_LADDER="2026-10-27:175000 2026-10-28:200000 2026-10-29:150000"

# Fallos preexistentes: un fallo fuera de esta lista es nuevo.
BASELINE_FAILURES="/home/user/.local/share/solidcraft-loop/baseline-failures.txt"

# Modelo del loop. OJO: los modelos opencode/*-free son free-tier y el CLI
# standalone los rechaza ("can only be used from within OpenCode"). El único
# provider autenticado en esta maquina es MiniMax.

# --- Upstream / fork ---
UPSTREAM=tangency-labs/solidcraft
FORK_OWNER=vdirienzo

# PRs nuestros que NO hay que trabajar más: son duplicados de PRs de otros
# autores y ya les comunicamos el "standing down" (#5130 duplica al #4635 de
# raykholo, #5105 al #4973 de aschoutz).
# El loop NO los cierra (cerrar es del humano, ver RUNBOOK.md): simplemente no
# gasta vueltas en ellos.
#
# #6458 es nuestro y duplica a otro nuestro: es un draft de sólo "claim:
# #6423" y el PR que lleva el trabajo es #6456 (el más bajo gana, la regla
# del repo). Contarlo dos veces el mismo fix inflaba `open_unmerged`, y
# adoptarlo sería implementar #6423 otra vez.
RETIRED_PRS=5130,5105,6458

# ¿El loop puede abrir PRs nuevos? 0 = no, nunca: se queda en modo
# maintenance aunque nuestros PRs abiertos bajen del umbral.
#
# 1 = el loop trabaja en modo `normal`: tria issues del upstream, reclama uno,
# lo implementa, lo revisa, lo gatea y publica el PR. Es la decisión de un
# humano (2026-10-23): el maintainer está respondiendo a nuestros PRs
# (bherbruck en #4629 y #4902) y cuatro de ellos ya están en la merge queue
# (#4545, #4588, #4657, #5053), o sea que el flujo funciona.
#
# Lo que sigue vigente: la aprobación de los workflows de GitHub es POR RUN
# y la pide un maintainer (nuestro `gh` no puede). Con la aprobación
# pendiente, cada PR nuevo nace con su run en `action_required`: el loop lo
# pide UNA vez por PR (el supervisor lleva la cuenta en `approval_asked`).
# El tope de PRs abiertos lo ponen MAINT_THRESHOLD (el autoparqueo del loop) y
# bin/claim-guard.sh (el tope real, verificado antes de abrir cada PR): al
# llegar a 10 PRs sin mergear, el loop deja de abrir nuevos.
# APAGADO DEL LOOP (2026-10-28, decisión del humano): con 0 el loop entra en
# modo `maintenance` y NO toma issues nuevas ni abre PRs nuevos (se queda
# con los PRs abiertos que ya tiene). Es el freno que corta la entrada de
# trabajo nuevo mientras el trabajo en vuelo (#7912 / PR #8010) se termina a
# mano. Volver a 1 lo reactiva.
ALLOW_NEW_PRS=0

# --- Costo, rate limit y rotación (Prompt 2, gaps G13-G15) ---
# Tope de vueltas por día: cada vuelta son hasta 8 agentes con un modelo de
# pago. Sin este tope, un loop desatendido se quema el presupuesto en un día.
#
# 288 = el loop trabaja 24 h: con un presupuesto de 55 min por vuelta, el
# ciclo real es de ~1 vuelta por hora (o ~26 por día), así que 288 es un
# freno de emergencia, no un presupuesto. Antes era 20 y a las 15:39 el
# loop empezó a saltarse todas las vueltas ("daily turn cap reached"), con
# lo que se quedó sin trabajar el resto del día.
MAX_TURNS_PER_DAY=288

# --- Los slots (el estado multi-issue) -------------------------------------
# Cuántos issues puede tener el loop en vuelo a la vez. Cada slot es una
# unidad de trabajo: su worktree, su rama, su estado y su lock. Con 2 slots,
# mientras el slot 0 espera el gate (50-75 min de CPU) el slot 1 implementa
# otro issue: el 67,6 % del tiempo de modelo estaba en 'gating' ESPERANDO.
#
# El gate sigue siendo UNO en toda la máquina (es CPU-bound: dos gates a la
# vez sólo duplican el tiempo) y sólo hay UNA fase pesada a la vez
# (implement, gate, evidencia). Lo que se paraleliza es el trabajo del
# modelo, que no usa CPU: usa la API.
#
# El coste: dos vueltas por hora de reloj en vez de una, así que el tope
# diario se gasta al doble (el supervisor lo reparte: MAX_TURNS_PER_DAY /
# MAX_SLOTS). Y el riesgo: dos turnos que tocan el repo a la vez, que es lo
# que el lock global de escritura del estado y el flock por slot evitan.
#
# 1 = un issue en vuelo (el comportamiento de antes de los slots).
MAX_SLOTS=2

# Minutos de espera después de un 429 / 403-secundario. El cooldown se
# duplica si el rate limit se repite.
RATE_LIMIT_COOLDOWN_MIN=30
# Días que se conservan los logs de vuelta y los PNG de evidencia.
# El ledger.md se conserva siempre: es la memoria del loop.
LOG_RETENTION_DAYS=14
# Retención POR CLASE (días). LOG_RETENTION_DAYS no se borra: es la clave
# legacy que lee bin/supervisor.sh (logs, turnos y evidencia con la MISMA
# ventana) y bin/loop.sh la exige en config.env. Estas son las ventanas por
# clase; bin/supervisor.sh todavía NO las lee (bin/ no es editable en este
# cambio), así que hoy son declarativas: pasarán a mandar cuando el script
# pase a leerlas.
RETENTION_TURNS_DAYS=14         # jsonl de los turnos del orquestador
RETENTION_LOGS_DAYS=7           # logs de vuelta y del gate (GATE_LOG_RETENTION_DAYS)
RETENTION_EVIDENCE_DAYS=30      # PNG y WebP de evidencia
# Regla de las 3 h: un issue en vuelo más de esto se da por perdido.
MAX_INFLIGHT_MIN=180
# Freno del issue en vuelo: `failed` NO es terminal (el issue se retoma), así
# que sin un contador el bucle puede dar vueltas sobre el mismo issue sin
# fin. Cada entrada en `failed` suma un intento; al pasar de este tope el
# issue pasa a `skipped` ("attempted N times without a published PR").
MAX_ATTEMPTS_PER_ISSUE=3
