#!/usr/bin/env python3
"""The token counter of OpenCode and of the SolidCraft loop.

WHY: the spend is the thing that has to be under control, and it is measured
in two places. The interactive sessions live in the database of OpenCode
(~/.local/share/opencode/opencode.db) and the turns of the loop live in the
JSONL of the loop (~/.local/share/solidcraft-loop/logs/YYYY-MM-DD.jsonl): the
loop runs `opencode run --standalone`, and the sessions of a turn that is over
are swept from the database, so the JSONL is the only record of them. A turn
that is running right now is in BOTH, and it is counted once.

The accounting is the one of the provider: the prompt is `input + cache.read`
(the cache is a discount, not a second prompt), and the output is
`output + reasoning`.

    oc-tokens                 the report of the last 24 hours
    oc-tokens --hours 48      another window
    oc-tokens --json          the same numbers, for a program
    oc-tokens --record        a line for metrics.log (key=value)

The rates are the ones of the provider (per million tokens): input 0.15,
output 0.60, cache read 0.015, reasoning 0.15 (the reasoning is billed as
input).
"""

import argparse
import collections
import datetime as dt
import glob
import json
import os
import sqlite3
import sys

DB = os.environ.get("OC_TOKENS_DB", os.path.expanduser("~/.local/share/opencode/opencode.db"))
LOOP_LOGS = os.environ.get("OC_TOKENS_LOOP", os.path.expanduser("~/.local/share/solidcraft-loop/logs"))

PRICE_INPUT = 0.15 / 1e6
PRICE_OUTPUT = 0.60 / 1e6
PRICE_CACHE = 0.015 / 1e6
PRICE_REASONING = 0.15 / 1e6

DAY = 86400


class Session:
    """The tokens of one session, with the moment of its last step."""

    __slots__ = ("input", "cache", "output", "reasoning", "steps", "first", "last", "source")

    def __init__(self):
        self.input = 0
        self.cache = 0
        self.output = 0
        self.reasoning = 0
        self.steps = 0
        self.first = 0
        self.last = 0
        self.source = "db"

    @property
    def total(self):
        return self.input + self.cache + self.output + self.reasoning

    def cost(self):
        return (
            self.input * PRICE_INPUT
            + self.output * PRICE_OUTPUT
            + self.cache * PRICE_CACHE
            + self.reasoning * PRICE_REASONING
        )

    def merge(self, other):
        """Two sources of the same session: the bigger one is the complete one."""
        if other.total > self.total:
            return other
        return self


def day_of(stamp):
    """The UTC day of a stamp in seconds."""
    if not stamp:
        return "unknown"
    return dt.datetime.fromtimestamp(stamp, dt.timezone.utc).date().isoformat()


class Days:
    """The tokens of each day, counted per message (not per session).

    A session that lasts a day and a half belongs to both days: the tokens it
    spent on each of them are the ones of the day they were spent on.
    """

    def __init__(self):
        self.buckets = collections.defaultdict(collections.Counter)

    def add(self, stamp, entry):
        bucket = self.buckets[day_of(stamp)]
        bucket["input"] += entry.input
        bucket["cache"] += entry.cache
        bucket["output"] += entry.output
        bucket["reasoning"] += entry.reasoning
        bucket["steps"] += entry.steps

    def as_dict(self, days):
        today = dt.datetime.now(dt.timezone.utc).date()
        out = {}
        for day, bucket in sorted(self.buckets.items()):
            try:
                when = dt.date.fromisoformat(day)
            except ValueError:
                continue
            if (today - when).days >= days:
                continue
            total = bucket["input"] + bucket["cache"] + bucket["output"] + bucket["reasoning"]
            out[day] = {
                "tokens": total,
                "cost": round(
                    bucket["input"] * PRICE_INPUT
                    + bucket["output"] * PRICE_OUTPUT
                    + bucket["cache"] * PRICE_CACHE
                    + bucket["reasoning"] * PRICE_REASONING,
                    4,
                ),
                "steps": bucket["steps"],
                # The breakdown of the day: the fresh input is the expensive
                # part, the cache read is the cheap one, and the comparison
                # against the baseline needs to tell them apart.
                "input": bucket["input"],
                "cache_read": bucket["cache"],
                "output": bucket["output"] + bucket["reasoning"],
            }
        return out


def to_seconds(value):
    """The epoch in seconds, from a stamp that may be in ms, us or ns."""
    try:
        stamp = int(value or 0)
    except (TypeError, ValueError):
        return 0
    while stamp > 100_000_000_000:  # 1e11 s is the year 5138: anything more is finer
        stamp //= 1000
    return stamp


def read_db(path, since, days):
    """The sessions of the database, in the window."""
    sessions = {}
    if not os.path.exists(path):
        return sessions
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
    except sqlite3.Error:
        return sessions
    try:
        rows = conn.execute(
            "SELECT session_id, time_created, data FROM session_message "
            "WHERE type='assistant' AND time_created >= ?",
            (since * 1000,),
        )
        for session_id, created, data in rows:
            try:
                obj = json.loads(data)
            except ValueError:
                continue
            tokens = obj.get("tokens") or {}
            cache = tokens.get("cache") or {}
            entry = sessions.get(session_id)
            if entry is None:
                entry = sessions[session_id] = Session()
            entry.input += tokens.get("input", 0) or 0
            entry.cache += cache.get("read", 0) or 0
            entry.output += tokens.get("output", 0) or 0
            entry.reasoning += tokens.get("reasoning", 0) or 0
            entry.steps += 1
            created = to_seconds(created)
            entry.first = min(entry.first or created, created)
            entry.last = max(entry.last, created)
            step = Session()
            step.input = tokens.get("input", 0) or 0
            step.cache = cache.get("read", 0) or 0
            step.output = tokens.get("output", 0) or 0
            step.reasoning = tokens.get("reasoning", 0) or 0
            step.steps = 1
            days.add(created, step)
    except sqlite3.Error as error:
        sys.stderr.write("oc-tokens: the database could not be read: %s\n" % error)
    finally:
        conn.close()
    return sessions


def read_loop(directory, since, days, known):
    """The turns of the loop: the JSONL of the days of the window.

    Only the `step_finish` events carry tokens, and they are a small part of
    the file, so the lines are filtered before they are parsed: the JSONL of a
    day is tens of megabytes and this runs every five minutes.

    The sessions that the database already has (`known`) are not counted in
    the days: they would be counted twice.
    """
    sessions = {}
    if not os.path.isdir(directory):
        return sessions
    for path in sorted(glob.glob(os.path.join(directory, "*.jsonl"))):
        name = os.path.basename(path)[:10]
        try:
            day = dt.datetime.strptime(name, "%Y-%m-%d").replace(tzinfo=dt.timezone.utc)
        except ValueError:
            continue
        if day.timestamp() + DAY < since:
            continue
        try:
            handle = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for line in handle:
                if '"step_finish"' not in line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if obj.get("type") != "step_finish":
                    continue
                part = obj.get("part") or {}
                tokens = part.get("tokens") or {}
                cache = tokens.get("cache") or {}
                session_id = part.get("sessionID") or obj.get("sessionID")
                if not session_id:
                    continue
                stamp = to_seconds((part.get("time") or {}).get("completed") or obj.get("timestamp"))
                if stamp and stamp < since:
                    continue
                entry = sessions.get(session_id)
                if entry is None:
                    entry = sessions[session_id] = Session()
                entry.input += tokens.get("input", 0) or 0
                entry.cache += cache.get("read", 0) or 0
                entry.output += tokens.get("output", 0) or 0
                entry.reasoning += tokens.get("reasoning", 0) or 0
                entry.steps += 1
                entry.source = "loop"
                entry.first = min(entry.first or stamp, stamp)
                entry.last = max(entry.last, stamp)
                step = Session()
                step.input = tokens.get("input", 0) or 0
                step.cache = cache.get("read", 0) or 0
                step.output = tokens.get("output", 0) or 0
                step.reasoning = tokens.get("reasoning", 0) or 0
                step.steps = 1
                if session_id not in known:
                    days.add(stamp, step)
    return sessions


def collect(hours):
    """The sessions of the window, from both sources, without duplicates."""
    now = int(dt.datetime.now(dt.timezone.utc).timestamp())
    since = now - hours * 3600
    days = Days()
    db = read_db(DB, since, days)
    loop = read_loop(LOOP_LOGS, since, days, set(db))
    merged = {}
    for session_id, entry in db.items():
        merged[session_id] = entry
    for session_id, entry in loop.items():
        other = merged.get(session_id)
        if other is None:
            merged[session_id] = entry
        else:
            merged[session_id] = other.merge(entry)
    return merged, days, now


def totals(sessions):
    """The sum of a set of sessions (a dict of them or a list)."""
    values = sessions.values() if isinstance(sessions, dict) else sessions
    acc = collections.Counter()
    for entry in values:
        acc["input"] += entry.input
        acc["cache"] += entry.cache
        acc["output"] += entry.output
        acc["reasoning"] += entry.reasoning
        acc["steps"] += entry.steps
    acc["total"] = acc["input"] + acc["cache"] + acc["output"] + acc["reasoning"]
    acc["cost"] = (
        acc["input"] * PRICE_INPUT
        + acc["output"] * PRICE_OUTPUT
        + acc["cache"] * PRICE_CACHE
        + acc["reasoning"] * PRICE_REASONING
    )
    return acc


def per_source(sessions):
    out = {}
    for source in ("db", "loop"):
        subset = {k: v for k, v in sessions.items() if v.source == source}
        out[source] = totals(subset)
    return out


def per_day(days, count):
    """The spend of each day, counted per message."""
    return days.as_dict(count)


def human(number):
    if number >= 1e9:
        return "%.2fB" % (number / 1e9)
    if number >= 1e6:
        return "%.1fM" % (number / 1e6)
    if number >= 1e3:
        return "%.1fK" % (number / 1e3)
    return str(number)


def report(sessions, days, now, hours, top):
    acc = totals(sessions)
    print("=== the tokens of the last %d hours ===" % hours)
    print("  sessions: %d   steps: %d" % (len(sessions), acc["steps"]))
    print(
        "  total:    %s tokens (%.2f%% cache)"
        % (human(acc["total"]), acc["cache"] / max(1, acc["total"]) * 100)
    )
    print("  input:    %s   cache read: %s" % (human(acc["input"]), human(acc["cache"])))
    print("  output:   %s   reasoning:   %s" % (human(acc["output"]), human(acc["reasoning"])))
    print("  cost:     $%.2f" % acc["cost"])
    print()
    print("  %-8s %8s %14s %10s" % ("source", "sessions", "tokens", "cost"))
    for source, values in per_source(sessions).items():
        if not values["steps"]:
            continue
        print(
            "  %-8s %8d %14s %9.2f$"
            % (
                source,
                sum(1 for v in sessions.values() if v.source == source),
                human(values["total"]),
                values["cost"],
            )
        )
    print()
    print("  %-12s %14s %10s %8s" % ("day", "tokens", "cost", "steps"))
    for day, values in per_day(days, 7).items():
        print("  %-12s %14s %9.2f$ %8d" % (day, human(values["tokens"]), values["cost"], values["steps"]))
    if top:
        print()
        print("  %-14s %14s %9s %6s  %s" % ("session", "tokens", "cost", "steps", "source"))
        for session_id, entry in sorted(sessions.items(), key=lambda kv: -kv[1].total)[:top]:
            print(
                "  %-14s %14s %8.2f$ %6d  %s"
                % (session_id[:14], human(entry.total), entry.cost(), entry.steps, entry.source)
            )


def as_json(sessions, days, hours):
    acc = totals(sessions)
    return {
        "hours": hours,
        "sessions": len(sessions),
        "steps": acc["steps"],
        "tokens": {
            "total": acc["total"],
            "input": acc["input"],
            "cache_read": acc["cache"],
            "output": acc["output"],
            "reasoning": acc["reasoning"],
        },
        "cost": round(acc["cost"], 4),
        "by_source": {
            source: {"tokens": values["total"], "cost": round(values["cost"], 4)}
            for source, values in per_source(sessions).items()
        },
        "by_day": per_day(days, 7),
    }


def main():
    parser = argparse.ArgumentParser(description="the token counter of OpenCode and of the loop")
    parser.add_argument("--hours", type=int, default=24, help="the window of the report (default: 24)")
    parser.add_argument("--json", action="store_true", help="the numbers, for a program")
    parser.add_argument("--record", action="store_true", help="a line for metrics.log")
    parser.add_argument("--top", type=int, default=10, help="how many sessions are listed (0: none)")
    args = parser.parse_args()

    sessions, days, now = collect(args.hours)
    if args.json:
        print(json.dumps(as_json(sessions, days, args.hours), indent=2))
        return 0
    if args.record:
        acc = totals(sessions)
        day = dt.datetime.now(dt.timezone.utc).date().isoformat()
        today = per_day(days, 2).get(day, {"tokens": 0, "cost": 0.0})
        print(
            "tokens_24h=%d tokens_in_24h=%d tokens_cache_24h=%d tokens_out_24h=%d "
            "cost_24h=%.4f sessions_24h=%d tokens_today=%d cost_today=%.4f"
            % (
                acc["total"],
                acc["input"],
                acc["cache"],
                acc["output"] + acc["reasoning"],
                acc["cost"],
                len(sessions),
                today["tokens"],
                today["cost"],
            )
        )
        return 0
    report(sessions, days, now, args.hours, args.top)
    return 0


if __name__ == "__main__":
    sys.exit(main())
