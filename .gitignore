# estado de la maquina: NO va al repo (se regenera en cada PC)
targets/
logs/
locks/
gates/
state/
state.json
history.jsonl
slots/
plan-features.json
# los worktrees de los slots: son estado, no codigo. Cada uno lleva un
# .gitignore que es un symlink al del repo, y por eso git avisaba de
# "too many levels of symbolic links" al recorrerlos.
loop-*/
# capturas y artefactos de una tanda: pesan y no son codigo
evidence/
repro/
go/
# los reports que escribe el loop en cada corrida: son estado de la maquina,
# no codigo. Los reports que SI son evidencia (una medicion, una captura
# revisada) van a evidence/ y a los PRs, no ahi.
reports/latest.md
# los briefs que la wave escribe para cada agente: son estado de la maquina,
# no codigo (el que es codigo es prompts/agent-brief.md, la plantilla)
prompts/agent-[0-9]*.md
reports/daily-*.md
reports/cron-prompt-actual.txt
# backups de parches
*.bak
*.bak-*
__pycache__/
*.pyc
# secretos
.env
*.env

# los briefs de cada slot: los renderiza prepare-slot.sh desde
# prompts/agent-brief.md; son estado de la maquina, no codigo.
prompts/agent-[0-9]*.md
prompts/repair-[0-9]*.md
prompts/old/

# copias de trabajo: 800 MB de codigo de upstream para inspeccion, no es codigo nuestro
scratch/
